{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rioriost/boticon/blob/main/docs/wallpaper-pack-v1.schema.json",
  "title": "Boticon Wallpaper Pack v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "id",
    "revision",
    "name",
    "author",
    "license",
    "wallpapers"
  ],
  "properties": {
    "format": {
      "const": "boticon-wallpaper-pack"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "wallpapers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file",
          "sha256",
          "bytes",
          "width",
          "height",
          "mediaType",
          "anchor",
          "attribution",
          "aiGenerated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "pattern": "^wallpapers/[a-z0-9-]+\\.(png|jpg)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "anchor": {
            "enum": [
              "lowerLeft",
              "lowerRight"
            ]
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "aiGenerated": {
            "type": "boolean"
          },
          "organization": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "debutDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  },
  "$comment": "Cross-field paths, unique IDs, exact byte/hash/image dimensions, text controls, URL restrictions and ZIP limits require the normative specification and runtime validator."
}
